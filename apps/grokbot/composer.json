{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "chat-on-steroids/grokbot",
  "type": "project",
  "description": "Production-grade persistent multi-bot control plane with dedicated TinyVM runtimes.",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "inertiajs/inertia-laravel": "^3.0",
    "laravel/framework": "^13.23",
    "laravel/reverb": "^1.11",
    "laravel/tinker": "^3.0",
    "laravel/wayfinder": "^0.1.14"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.9",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "pestphp/pest": "^5.0.1",
    "pestphp/pest-plugin-laravel": "^5.0.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "dev": ["Composer\\Config::disableProcessTimeout", "npx concurrently \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan reverb:start\" \"npm run dev\" --names=http,queue,reverb,vite --kill-others"],
    "test": ["@php artisan config:clear --ansi", "@php artisan test"],
    "quality": ["@php vendor/bin/pint --test", "@php vendor/bin/phpstan analyse", "@php artisan test"]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {"pestphp/pest-plugin": true, "php-http/discovery": true}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
