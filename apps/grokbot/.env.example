APP_NAME="Grokbot Control Plane"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grokbot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=grokbot-local
REVERB_APP_KEY=grokbot-local-key
REVERB_APP_SECRET=grokbot-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

TINYVM_DRIVER=fake
TINYVM_GATEWAY_URL=http://127.0.0.1:8787
TINYVM_GATEWAY_TOKEN=
TINYVM_DEFAULT_VCPU=2
TINYVM_DEFAULT_MEMORY_MB=4096
TINYVM_DEFAULT_DISK_GB=20
